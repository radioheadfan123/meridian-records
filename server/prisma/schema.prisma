generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PROVIDER
  FRONT_DESK
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LIST
  READ
  CREATE
  UPDATE
  DELETE
  DENIED
  BREAK_GLASS
}

// Coarse scheduling category. Deliberately NOT encrypted: it is the operational
// data the calendar is built on (filtering, slot length, room assignment), and it
// is a fixed vocabulary rather than free text about the patient. The free-text
// reason that sits beside it IS encrypted - that is where the line falls.
enum VisitType {
  NEW_PATIENT
  FOLLOW_UP
  ANNUAL_PHYSICAL
  LAB_REVIEW
  VACCINATION
  TELEHEALTH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role
  failedAttempts   Int               @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime          @default(now())
  auditLogs        AuditLog[]
  breakGlassGrants BreakGlassGrant[]
  appointments     Appointment[]
}

model Patient {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  dob       DateTime
  phone     String
  email     String?
  address   String?

  // Sensitive fields: AES-256-GCM ciphertext ("iv:authTag:ciphertext", base64).
  // Encrypted in application code before it ever reaches the database.
  ssnEnc               String?
  diagnosisEnc         String?
  medicationHistoryEnc String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  breakGlassGrants BreakGlassGrant[]
  appointments     Appointment[]
}

// The scoped scheduling view. This model exists to replace a simplification the
// README called out: access used to be a binary field block, so front desk saw
// either the whole clinical record or none of it, and "none of it" is not enough
// to run a calendar. An appointment carries the minimum necessary to schedule -
// a visit category, a short scheduling reason, a time - and nothing more.
//
// `reasonEnc` is NOT the diagnosis. It is a purpose-limited scheduling note
// ("follow-up on lab results") written for the front desk, while diagnosisEnc
// stays clinical and stays invisible to them. Two fields, two purposes, two
// audiences: that distinction is the whole point of the feature.
model Appointment {
  id        String  @id @default(uuid())
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  // The clinician the visit is with. Nullable so front desk can book a slot
  // before assignment, which is how real intake actually works.
  provider   User?   @relation(fields: [providerId], references: [id])
  providerId String?

  visitType VisitType

  // Free text about a patient, so it gets the same AES-256-GCM treatment as every
  // other free-text PHI field in this app. Being scheduling-scoped does not make
  // it less sensitive at rest; it only changes who is allowed to read it.
  reasonEnc String?

  startsAt        DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([startsAt])
  @@index([providerId, startsAt])
}

// Append-only by design: the API exposes no update or delete operations on this table.
model AuditLog {
  id             String      @id @default(uuid())
  user           User        @relation(fields: [userId], references: [id])
  userId         String
  action         AuditAction

  // Deliberately NOT a foreign key.
  //
  // This used to be `patient Patient? @relation(..., onDelete: SetNull)`, and that
  // quietly defeated the hash chain below: deleting a patient rewrote patientId to
  // NULL on every audit row that referenced them, and since the hash covers
  // patientId, /api/audit/verify then correctly reported those rows as tampered.
  // Two features that are each right on their own, contradicting each other - an
  // append-only table cannot hold a reference that some other operation is allowed
  // to mutate. Found 2026-09-02 by running verify after a patient deletion, which
  // nothing had done before.
  //
  // A deleted patient's id is a historical fact and the log's job is to keep it, so
  // the id now stays put and nothing can rewrite it. The cost is that the audit
  // route resolves patient names with its own lookup instead of a join.
  patientId      String?
  fieldsAccessed String[]    @default([])
  detail         String?
  ip             String?
  timestamp      DateTime    @default(now())

  // Hash chain for tamper-evidence: hash = sha256(prevHash + this row's fields).
  // Nullable because rows written before this feature existed have neither; the
  // backfill script (scripts/backfill-audit-hashes.js) chains them retroactively.
  prevHash String?
  hash     String?

  // The real guarantee against a forked chain: at most one row may claim a given
  // prevHash, enforced by Postgres on every insert regardless of what the app layer
  // does. (Multiple NULLs are allowed by Postgres unique-index semantics, which is
  // exactly right for the not-yet-backfilled rows that predate this feature.)
  @@unique([prevHash])
  @@index([userId])
  @@index([patientId])
  @@index([timestamp])
}

// Time-limited emergency access. A grant does not itself grant access silently:
// every read taken under it is logged as BREAK_GLASS, not READ, so it stays
// loud for the admin audit review this feature exists for.
model BreakGlassGrant {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  reason    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, patientId, expiresAt])
}
