# Supabase: Project Settings > Database > Connection string
# Pooled (pgbouncer) URL for the app:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for migrations (prisma db push):
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# openssl rand -hex 64
JWT_SECRET=""

# EXACTLY 64 hex chars (32 bytes): openssl rand -hex 32
# This is always key version 1. To rotate: add FIELD_ENCRYPTION_KEY_V2 (also 64 hex
# chars) alongside this one - new writes immediately use the highest version present,
# old data stays readable under whichever version it was written with. Once
# scripts/reencrypt-to-latest.js has migrated everything to the new version, the old
# key can be removed. See src/lib/crypto.js for the format.
FIELD_ENCRYPTION_KEY=""
# FIELD_ENCRYPTION_KEY_V2=""

# Comma-separated allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

PORT=4000
